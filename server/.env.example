# CareCircle AI — Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=production

# Allowed CORS client origin (in production set to your Vercel URL, e.g. https://carecircle-ai.vercel.app)
# Supports comma-separated list of origins for preview environments
CLIENT_URL=http://localhost:5173

# SQLite Database Location
# Locally: ./data/carecircle.db
# On Render with Persistent Disk mounted at /var/data: /var/data/carecircle.db
DATABASE_PATH=./data/carecircle.db

# Optional AI Assistant (Gemini)
# Leave empty to operate in built-in deterministic demo mode
GEMINI_API_KEY=

# Optional Amazon SES Notifications
# Leave empty to operate in safe Simulated SES Mode (logged to activity audit trail)
SES_SENDER_EMAIL=care@carecircle.demo
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
